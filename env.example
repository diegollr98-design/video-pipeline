# Plantilla de variables de entorno.
# Copia este fichero a `.env` (que esta gitignored) y rellena las claves:
#     cp env.example .env

# OpenRouter — genera las historias. OBLIGATORIA.
# Se saca en https://openrouter.ai/keys (el modelo por defecto es un :free).
OPENROUTER_API_KEY=

# YouTube Data API v3 — SOLO para el analisis de competencia (Fase 3).
# El pipeline de video funciona sin ella. Se saca en Google Cloud Console.
YOUTUBE_API_KEY=

# La subida a YouTube NO usa una API key: usa OAuth. Necesita un
# `client_secret.json` de tu propio proyecto de Google Cloud, colocado en
# `data/client_secret.json` (ver modules/youtube_uploader.py).
