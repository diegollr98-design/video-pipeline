.env
# Overlay de config por maquina: el repo lleva rutas RELATIVAS para que un clon
# arranque sin editar nada, y cada maquina pone las suyas aqui (utils.load_config
# lo superpone si existe). Asi config.yaml deja de estar modificado en cada copia.
config.local.yaml
test_e2e/config.local.yaml
input/
output/
temp/
pool/
shorts_tiktok/
# `data/` es state generado (informes de competencia, credenciales OAuth) y no
# se versiona. Excepcion: los baselines de medicion de `/eval`. Son las cifras
# que el README cita, y una cifra citada que no se puede abrir no es evidencia.
# Mismo truco que test_e2e: hay que excluir `data/*` y no `data/`, o git no
# puede re-incluir nada de dentro (un directorio excluido no se recorre).
data/*
!data/eval/
data/eval/*
!data/eval/*.json
__pycache__/
*.pyc
pipeline.log
*.bak
# El fixture del gate: se ignora el contenido (clip.mp4 son 1,5 GB) pero la
# config SÍ se versiona — un gate que cada uno tiene distinto no es un gate.
# Ojo: tiene que ser `test_e2e/*` y no `test_e2e/`, o git no puede re-incluir
# nada de dentro (un directorio excluido no se recorre).
test_e2e/*
!test_e2e/config.yaml

# Las paginas del portafolio viven en su propio repo, una por
# carpeta. Aqui llegaron a colarse 4 copias (SEKURA, PUMPFUN-BOT, RESELLERMASTER,
# YOUTUBE-PIPELINE) que ademas quedaron DESACTUALIZADAS: la de este proyecto tenia
# 130 KB contra los 197 KB de la buena, sin el bloque de 'error medio por regimen'.
# Un repo publico con una version vieja de tu propia pagina es peor que no tenerla.
PORTAFOLIO/

# Multimedia de TERCEROS: no se redistribuye (ver assets/README.md y LICENSE).
# Los ficheros siguen en disco; simplemente no se versionan.
assets/3.png
assets/*.mp3
