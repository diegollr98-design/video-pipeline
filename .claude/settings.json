{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python *)",
      "Bash(py -*)",
      "Bash(PYTHONUTF8=1 python *)",
      "Bash(PYTHONIOENCODING=utf-8 python *)",
      "Bash(pip install *)",
      "Bash(pip list *)",
      "Bash(streamlit *)",
      "Bash(ffmpeg *)",
      "Bash(ffprobe *)",
      "Bash(ollama *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git status*)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git stash *)",
      "Bash(git branch*)",
      "Bash(git checkout *)",
      "Bash(git init*)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "Bash(wc *)",
      "Read(*)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -r *)",
      "Bash(sudo *)",
      "Bash(git push --force*)",
      "Bash(git reset --hard*)",
      "Read(.env*)",
      "Write(.env)",
      "Read(**/*.key)",
      "Read(**/.secret*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "PYTHONUTF8=1 python -m compileall -q modules main.py dashboard.py dashboard_runner.py",
            "on_failure": "warn"
          }
        ]
      }
    ]
  }
}
